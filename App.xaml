<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TailscaleClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TailscaleClient">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <BitmapImage x:Key="AppIconImage" UriSource="ms-appx:///Assets/Icons/AppIconBase-Light.png" />
                    <ImageIconSource x:Key="AppTitleBarIcon" ImageSource="{StaticResource AppIconImage}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="AppIconImage" UriSource="ms-appx:///Assets/Icons/AppIconBase-Dark.png" />
                    <ImageIconSource x:Key="AppTitleBarIcon" ImageSource="{StaticResource AppIconImage}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Assets/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PageContentStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="24,20,24,32" />
                <Setter Property="Spacing" Value="24" />
                <Setter Property="MaxWidth" Value="1008" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="AppThemePageStyle" TargetType="Page">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>



