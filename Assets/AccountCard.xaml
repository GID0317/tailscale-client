<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TailscaleClient.Assets.AccountCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <controls:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
        <controls:SettingsCard.ContextFlyout>
            <MenuFlyout><MenuFlyoutItem Text="Delete account" Click="DeleteAccount" Icon="Delete" /></MenuFlyout>
        </controls:SettingsCard.ContextFlyout>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse.Fill><ImageBrush><ImageBrush.ImageSource>
                    <BitmapImage UriSource="{x:Bind ProfilePicture, Mode=OneWay}" DecodePixelHeight="80" DecodePixelWidth="80" />
                </ImageBrush.ImageSource></ImageBrush></Ellipse.Fill>
            </Ellipse>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind UserName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Tailnet, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="SwitchAccount" Grid.Column="2" Content="Switch" Click="ChangeAccount" VerticalAlignment="Center"
                AutomationProperties.Name="Switch to this account" />
            <Button Grid.Column="3" VerticalAlignment="Center" Padding="6"
                ToolTipService.ToolTip="Account actions" AutomationProperties.Name="Account actions">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout><MenuFlyoutItem Text="Delete account" Click="DeleteAccount" Icon="Delete" /></MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </controls:SettingsCard>
</UserControl>
