<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TailscaleClient.Views.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
        <Grid Width="{Binding ViewportWidth, ElementName=PageScrollViewer}">
            <StackPanel Style="{StaticResource PageContentStyle}" Width="{Binding ViewportWidth, ElementName=PageScrollViewer}">
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Spacing="8">
                    <TextBlock Text="This device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="MyDevice" />
                    <InfoBar x:Name="ConnectionNotice" IsClosable="False" Severity="Informational" />
                </StackPanel>
                <StackPanel x:Name="PeerSection" Spacing="8">
                    <TextBlock Text="Other devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceSearch" PlaceholderText="Search devices"
                            TextChanged="SearchChanged" AutomationProperties.Name="Search other devices"
                            AutomationProperties.HelpText="Search by device name or address" />
                        <CheckBox x:Name="OwnedDevicesFilter" Grid.Column="1" Content="Only my devices"
                            Checked="OwnershipChanged" Unchecked="OwnershipChanged" />
                    </Grid>
                    <StackPanel x:Name="OtherDevices" Spacing="4" />
                    <TextBlock x:Name="NoDevicesMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
